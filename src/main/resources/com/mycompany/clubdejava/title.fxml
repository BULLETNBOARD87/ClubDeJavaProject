<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1100.0" styleClass="title-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clubdejava.TitleController">
   <children>
      <VBox alignment="CENTER" spacing="25.0">
         <children>
            <Label styleClass="game-title" text="Club De Java" />
            <Label styleClass="section-title" text="Choose Difficulty" />
            <HBox alignment="CENTER" spacing="50.0">
               <children>
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <ToggleButton id="easy-button" fx:id="easyButton" onAction="#onEasy" prefHeight="55.0" prefWidth="170.0" selected="true" styleClass="difficulty-button" text="Easy">
                           <toggleGroup>
                              <ToggleGroup fx:id="difficultyGroup" />
                           </toggleGroup>
                        </ToggleButton>
                        <Label fx:id="easySelected" styleClass="selected-label" text="selected" visible="false" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <ToggleButton id="medium-button" fx:id="mediumButton" onAction="#onMedium" prefHeight="55.0" prefWidth="170.0" styleClass="difficulty-button" text="Medium" toggleGroup="$difficultyGroup" />
                        <Label fx:id="mediumSelected" styleClass="selected-label" text="selected" visible="false" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <ToggleButton id="hard-button" fx:id="hardButton" onAction="#onHard" prefHeight="55.0" prefWidth="170.0" styleClass="difficulty-button" text="Hard" toggleGroup="$difficultyGroup" />
                        <Label fx:id="hardSelected" styleClass="selected-label" text="selected" visible="false" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="courseInfo" styleClass="hint" text="Pick a course: Easy, Medium or Hard." />
            <Label styleClass="section-title" text="Choose number of players" />
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <ToggleButton fx:id="players1" mnemonicParsing="false" onAction="#onPlayers" prefHeight="66.0" prefWidth="66.0" styleClass="player-button" text="1">
                     <toggleGroup>
                        <ToggleGroup fx:id="playersGroup" />
                     </toggleGroup>
                  </ToggleButton>
                  <ToggleButton fx:id="players2" mnemonicParsing="false" onAction="#onPlayers" prefHeight="66.0" prefWidth="66.0" styleClass="player-button" text="2" toggleGroup="$playersGroup" />
                  <ToggleButton fx:id="players3" mnemonicParsing="false" onAction="#onPlayers" prefHeight="66.0" prefWidth="66.0" styleClass="player-button" text="3" toggleGroup="$playersGroup" />
                  <ToggleButton fx:id="players4" mnemonicParsing="false" onAction="#onPlayers" prefHeight="66.0" prefWidth="66.0" styleClass="player-button" text="4" toggleGroup="$playersGroup" />
               </children>
            </HBox>
            <Label fx:id="playersHint" styleClass="hint" text="(Choose 1 to 4 players)" />
            <Button fx:id="startButton" onAction="#onStart" prefHeight="60.0" prefWidth="220.0" styleClass="start-button" text="START GAME" />
            <Label styleClass="hint" text="How to play: click your ball, drag backwards to aim, release to shoot. Fewest shots wins!" />
         </children>
      </VBox>
   </children>
</StackPane>
